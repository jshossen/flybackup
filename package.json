{
  "name": "flybackup",
  "version": "1.0.0",
  "description": "Fast, reliable WordPress backups that just work",
  "main": "assets/src/index.js",
  "scripts": {
    "start": "webpack --mode development --watch",
    "dev": "webpack --mode development",
    "build:assets": "webpack --mode production",
    "build": "npm run build:assets && node build.js",
    "build:pro": "npm run build:assets && node build-pro.js",
    "clean": "rm -rf assets/js/admin-script.js* assets/css/admin-style.css*"
  },
  "keywords": [
    "wordpress",
    "backup",
    "restore",
    "automatic",
    "flybackup"
  ],
  "author": "jshossen",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "mini-css-extract-plugin": "^2.7.6",
    "sass": "^1.69.0",
    "sass-loader": "^13.3.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^6.44.0",
    "@wordpress/i18n": "^4.47.0",
    "chart.js": "^4.4.0",
    "date-fns": "^2.30.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0"
  }
}
